{
  "name": "vpc-sync",
  "displayName": "VPC Sync",
  "description": "Version control for VPC — push, pull, commit, branch. Like Git but using VPC VCS.",
  "publisher": "vpc-admin",
  "version": "8.0.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["SCM Providers"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vpcSync",
          "title": "VPC Sync",
          "icon": "$(cloud)"
        }
      ]
    },
    "views": {
      "vpcSync": [
        {
          "id": "vpcSync.panel",
          "name": "VPC Sync",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "vpcSync.connect", "title": "VPC Sync: Connect to VPSHub", "icon": "$(plug)" },
      { "command": "vpcSync.push", "title": "VPC Sync: Push", "icon": "$(arrow-up)" },
      { "command": "vpcSync.pull", "title": "VPC Sync: Pull", "icon": "$(arrow-down)" },
      { "command": "vpcSync.commit", "title": "VPC Sync: Commit", "icon": "$(check)" },
      { "command": "vpcSync.refresh", "title": "VPC Sync: Refresh", "icon": "$(refresh)" },
      { "command": "vpcSync.stageFile", "title": "Stage", "icon": "$(add)" },
      { "command": "vpcSync.unstageFile", "title": "Unstage", "icon": "$(remove)" },
      { "command": "vpcSync.stageAll", "title": "Stage All", "icon": "$(add)" },
      { "command": "vpcSync.unstageAll", "title": "Unstage All", "icon": "$(remove)" },
      { "command": "vpcSync.openFile", "title": "Open File", "icon": "$(go-to-file)" },
      { "command": "vpcSync.discardFile", "title": "Discard Changes", "icon": "$(discard)" },
      { "command": "vpcSync.createBranch", "title": "VPC Sync: Create Branch", "icon": "$(git-branch)" },
      { "command": "vpcSync.switchBranch", "title": "VPC Sync: Switch Branch", "icon": "$(git-branch)" },
      { "command": "vpcSync.deleteBranch", "title": "VPC Sync: Delete Branch", "icon": "$(trash)" }
    ],
    "menus": {
      "scm/title": [
        { "command": "vpcSync.commit", "when": "scmProvider == vpc-sync", "group": "navigation@1" },
        { "command": "vpcSync.push", "when": "scmProvider == vpc-sync", "group": "navigation@2" },
        { "command": "vpcSync.pull", "when": "scmProvider == vpc-sync", "group": "navigation@3" },
        { "command": "vpcSync.refresh", "when": "scmProvider == vpc-sync", "group": "navigation@4" }
      ],
      "scm/resourceGroup/context": [
        { "command": "vpcSync.stageAll", "when": "scmProvider == vpc-sync && scmResourceGroup == changes", "group": "inline" },
        { "command": "vpcSync.stageAll", "when": "scmProvider == vpc-sync && scmResourceGroup == untracked", "group": "inline" },
        { "command": "vpcSync.unstageAll", "when": "scmProvider == vpc-sync && scmResourceGroup == staged", "group": "inline" }
      ],
      "scm/resourceState/context": [
        { "command": "vpcSync.stageFile", "when": "scmProvider == vpc-sync && scmResourceGroup == changes", "group": "inline@1" },
        { "command": "vpcSync.stageFile", "when": "scmProvider == vpc-sync && scmResourceGroup == untracked", "group": "inline@1" },
        { "command": "vpcSync.unstageFile", "when": "scmProvider == vpc-sync && scmResourceGroup == staged", "group": "inline@1" },
        { "command": "vpcSync.openFile", "when": "scmProvider == vpc-sync", "group": "inline@2" },
        { "command": "vpcSync.discardFile", "when": "scmProvider == vpc-sync && scmResourceGroup == changes", "group": "inline@3" }
      ],
      "view/title": [
        { "command": "vpcSync.refresh", "when": "view == vpcSync.panel", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "vpcSync.commit", "key": "ctrl+enter", "mac": "cmd+enter", "when": "scmProvider == vpc-sync && scmInputIsInFocus" }
    ],
    "configuration": {
      "title": "VPC Sync",
      "properties": {
        "vpcSync.serverUrl": { "type": "string", "default": "", "description": "VPSHub server URL (e.g. http://your-server:8001)" },
        "vpcSync.token": { "type": "string", "default": "", "description": "VPSHub Personal Access Token (starts with vpshub_)" },
        "vpcSync.repository": { "type": "string", "default": "", "description": "Repository (owner/name)" },
        "vpcSync.username": { "type": "string", "default": "", "description": "VPSHub username" },
        "vpcSync.branch": { "type": "string", "default": "main", "description": "Branch to sync" },
        "vpcSync.autoRefreshInterval": { "type": "number", "default": 0, "description": "Auto-refresh interval in seconds (0=disabled)" }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
