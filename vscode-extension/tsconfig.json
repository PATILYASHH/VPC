{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "out",
    "src/commands/hosting.ts",
    "src/commands/issues.ts",
    "src/views/codePRsProvider.ts",
    "src/views/dashboardProvider.ts",
    "src/views/hostingProvider.ts",
    "src/views/issuesProvider.ts"
  ]
}
