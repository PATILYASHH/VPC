NODE_ENV=development
PORT=8001

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vpc
DB_USER=vpc_admin
DB_PASSWORD=your_password_here

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-64-character-string
JWT_EXPIRES_IN=24h

# Initial admin (used by seed-admin.js)
VPC_ADMIN_USERNAME=admin
VPC_ADMIN_EMAIL=admin@example.com
VPC_ADMIN_PASSWORD=change_this_password

# Optional features
ENABLE_IP_RESTRICTION=false
FRONTEND_URL=http://localhost:5173

# Backup directory
BACKUP_DIR=./backups

# Claude AI (optional - for PR review / Smart Merge)
ANTHROPIC_API_KEY=

# Log file paths (update for your server)
LOG_PATH_ERP=/var/log/erp/app.log
LOG_PATH_NGINX_ACCESS=/var/log/nginx/access.log
LOG_PATH_NGINX_ERROR=/var/log/nginx/error.log
